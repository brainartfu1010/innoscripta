# Local development uses port 3001 so it can sit beside the Vite dev server.
# Docker Compose sets PORT=3000 itself.
PORT=3001

# Server-side only. Never put these in client code or commit real values.
# Guardian: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=

# New York Times Article Search: https://developer.nytimes.com/
NYT_API_KEY=

# NewsAPI.org developer plan (local development): https://newsapi.org/register
NEWSAPI_API_KEY=
